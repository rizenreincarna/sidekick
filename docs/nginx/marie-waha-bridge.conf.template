# TEMPLATE ONLY. Do not install or reload nginx during foundation work.
# Bind this listener only to the Docker bridge/host-gateway address, never 0.0.0.0.
server {
    listen HOST_BRIDGE_IP:18080;
    server_name _;
    client_max_body_size 64k;

    location = /waha-webhook {
        allow WAHA_CONTAINER_SUBNET;
        deny all;
        proxy_set_header X-Webhook-Secret "REPLACE_WITH_MARIE_WAHA_WEBHOOK_SECRET";
        proxy_set_header Host 127.0.0.1;
        proxy_pass http://127.0.0.1:3000/api/internal/marie/waha-webhook;
        proxy_connect_timeout 2s;
        proxy_read_timeout 10s;
    }
}
