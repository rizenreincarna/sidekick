generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                      @id @default(cuid())
  username              String                      @unique
  password              String
  displayName           String?
  role                  Role                        @default(HERO)
  isActive              Boolean                     @default(true)
  isApproved            Boolean                     @default(false)
  twoFactorEnabled      Boolean                     @default(false)
  twoFactorSecret       String?
  lastLoginAt           DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  aiActions             AiAction[]
  aiConversations       AiConversation[]
  aiFlags               AiFlag[]
  auditLogs             AuditLog[]
  chatMessages          ChatMessage[]
  deviceTokens          DeviceToken[]
  driverLocations       DriverLocation[]
  erthboxLocations      ErthboxLocation[]
  heroProfile           HeroProfile?
  holidays              Holiday[]
  notifications         Notification[]
  offDays               OffDay[]
  orders                Order[]
  routes                Route[]
  sosAnswered           SOSRequest[]                @relation("AnsweredSOS")
  sosRequests           SOSRequest[]
  settings              Setting[]
  trackingLinks         TrackingLink[]
  userZones             UserZone[]
  zoneConfigs           ZoneConfig[]
  marieRateReservations AutomationRateReservation[]
}

model Route {
  id                String             @id @default(cuid())
  date              String
  userId            String
  vehicleId         Int
  routeData         String
  idMapping         String
  totalDistance     Float
  totalDuration     Int
  stopCount         Int
  status            String             @default("OPTIMIZED")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  routeAlternatives RouteAlternative[]

  @@unique([userId, date])
  @@index([userId, date])
}

model RouteAlternative {
  id              String   @id @default(cuid())
  routeId         String
  dropOff         String // DROP_A | DROP_B per load
  loadIndex       Int
  distanceMeters  Float
  durationSeconds Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  route           Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, loadIndex])
  @@index([routeId])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId, isActive])
}

model Order {
  id                      String                 @id @default(cuid())
  orderId                 String
  customerName            String
  phone                   String
  address                 String
  city                    String
  size                    String
  points                  Int
  zone                    Int
  isOffice                Boolean                @default(false)
  isEvent                 Boolean                @default(false)
  eventType               String?
  isErthbox               Boolean                @default(false)
  erthboxLocationId       String?
  status                  String                 @default("PENDING")
  scheduledDate           String?
  notes                   String?
  latitude                Float?
  longitude               Float?
  addressVerified         Boolean                @default(false)
  addressVerificationNote String?
  userId                  String
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  erthboxLocation         ErthboxLocation?       @relation(fields: [erthboxLocationId], references: [id])
  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  marieConversations      CustomerConversation[]
  marieJobs               AutomationJob[]
  marieEscalations        CustomerEscalation[]
  marieHolds              OrderHold[]
  marieEvents             AutomationEvent[]

  @@unique([userId, orderId])
  @@index([userId, status])
  @@index([userId, scheduledDate])
  @@index([status])
  @@index([userId, createdAt])
  @@index([isErthbox])
  @@index([erthboxLocationId])
}

model MarieAutomationConfig {
  id                       String   @id @default("default")
  enabled                  Boolean  @default(false)
  mode                     String   @default("DRY_RUN")
  contactStartHour         Int      @default(8)
  contactEndHour           Int      @default(20)
  normalCapacity           Int      @default(20)
  maxCapacity              Int      @default(25)
  pilotAllowlist           String   @default("[]")
  maxMessagesPerRun        Int      @default(10)
  maxMessagesPerHour       Int      @default(20)
  maxMessagesPerDay        Int      @default(100)
  maxMessagesPerTick       Int      @default(3)
  maxRetries               Int      @default(3)
  wahaSessionName          String?
  telegramOwnerId          String?
  escalationEnabled        Boolean  @default(false)
  inboundProcessingEnabled Boolean  @default(false)
  contactMode              String   @default("WHITELIST")
  orderAllowlist           String   @default("[]")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model CustomerConversation {
  id               String                      @id @default(cuid())
  orderId          String?
  chatId           String
  normalizedPhone  String?
  lid              String?
  state            String                      @default("ACTIVE")
  language         String?
  pausedAt         DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  order            Order?                      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages         CustomerMessage[]
  jobs             AutomationJob[]
  escalations      CustomerEscalation[]
  events           AutomationEvent[]
  rateReservations AutomationRateReservation[]

  @@unique([orderId, chatId])
  @@index([state, updatedAt])
  @@index([normalizedPhone])
  @@index([chatId])
  @@index([lid])
}

model CustomerMessage {
  id                String                     @id @default(cuid())
  conversationId    String
  direction         String
  providerMessageId String?                    @unique
  idempotencyKey    String                     @unique
  body              String?
  bodyHash          String?
  messageType       String                     @default("TEXT")
  deliveryState     String                     @default("PENDING")
  retryCount        Int                        @default(0)
  providerTimestamp DateTime?
  metadata          String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  sendStartedAt     DateTime?
  conversation      CustomerConversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  events            AutomationEvent[]
  rateReservation   AutomationRateReservation?

  @@index([conversationId, createdAt])
  @@index([direction, deliveryState])
}

model AutomationJob {
  id             String                @id @default(cuid())
  orderId        String?
  conversationId String?
  kind           String
  state          String                @default("PENDING")
  idempotencyKey String                @unique
  runAfter       DateTime
  leaseUntil     DateTime?
  leaseToken     String?
  attempts       Int                   @default(0)
  deadLetteredAt DateTime?
  lastErrorCode  String?
  payload        String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  order          Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  conversation   CustomerConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([state, runAfter])
  @@index([orderId, state])
}

model AutomationRateReservation {
  id             String               @id @default(cuid())
  userId         String
  conversationId String
  messageId      String               @unique
  hourBucket     String
  dayBucket      String
  reservedAt     DateTime             @default(now())
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   CustomerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        CustomerMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, hourBucket])
  @@index([userId, dayBucket])
  @@index([conversationId, hourBucket])
}

model MarieWebhookDelivery {
  id          String    @id @default(cuid())
  deliveryKey String    @unique
  envelopeId  String?
  eventType   String
  sessionName String
  outcome     String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([eventType, receivedAt])
}

model MarieUnmatchedWebhook {
  id                String   @id @default(cuid())
  providerMessageId String?  @unique
  eventType         String
  reasonCode        String
  identifierKind    String
  receivedAt        DateTime @default(now())

  @@index([reasonCode, receivedAt])
}

model CustomerEscalation {
  id             String                @id @default(cuid())
  orderId        String?
  conversationId String?
  correlationId  String                @unique
  category       String
  severity       String
  state          String                @default("OPEN")
  summary        String
  proposedAction String?
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  order          Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  conversation   CustomerConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([state, severity, createdAt])
  @@index([orderId, state])
}

model OrderHold {
  id         String    @id @default(cuid())
  orderId    String?
  reasonCode String
  reason     String
  state      String    @default("ACTIVE")
  createdBy  String
  releasedBy String?
  releasedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId, state])
  @@index([state, createdAt])
}

model AutomationEvent {
  id             String                @id @default(cuid())
  orderId        String?
  conversationId String?
  messageId      String?
  eventType      String
  actor          String
  idempotencyKey String                @unique
  beforeState    String?
  afterState     String?
  reasonCode     String?
  metadata       String?
  createdAt      DateTime              @default(now())
  order          Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  conversation   CustomerConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message        CustomerMessage?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([conversationId, createdAt])
  @@index([eventType, createdAt])
}

model Holiday {
  id     String @id @default(cuid())
  date   String
  name   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model OffDay {
  id     String  @id @default(cuid())
  date   String
  reason String?
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model Setting {
  id     String @id @default(cuid())
  key    String
  value  String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model ZoneConfig {
  id         String  @id @default(cuid())
  zone       Int
  area       String
  isExcluded Boolean @default(false)
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, zone, area])
}

model UserZone {
  id        String  @id @default(cuid())
  zoneId    Int
  name      String
  region    String
  isCustom  Boolean @default(false)
  isEnabled Boolean @default(true)
  areas     String  @default("[]")
  order     Int     @default(0)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, zoneId])
}

model SOSRequest {
  id           String   @id @default(cuid())
  orderId      String
  orderRef     String
  customerName String
  phone        String
  address      String
  city         String
  size         String
  points       Int
  zone         Int
  isOffice     Boolean  @default(false)
  notes        String?
  sosNote      String
  status       String   @default("ACTIVE")
  fromUserId   String
  toUserId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  toUser       User?    @relation("AnsweredSOS", fields: [toUserId], references: [id], onDelete: Cascade)
  fromUser     User     @relation(fields: [fromUserId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([fromUserId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action, entity])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  message   String
  mentions  String   @default("[]")
  isDeleted Boolean  @default(false)
  deletedBy String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isDeleted, createdAt])
}

model HeroProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  heroName      String
  plateNumber   String
  vehicleColor  String   @default("black")
  vehicleModel  String   @default("")
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
  homeLatitude  Float?
  homeLongitude Float?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DriverLocation {
  id        String   @id @default(cuid())
  userId    String
  latitude  Float
  longitude Float
  heading   Float?
  speed     Float?
  routeDate String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  source    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model TrackingLink {
  id            String    @id @default(cuid())
  token         String    @unique
  orderId       String
  userId        String
  routeDate     String
  customerName  String
  customerPhone String?
  latitude      Float
  longitude     Float
  stopNumber    Int
  plannedEta    String?
  completedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, routeDate])
}

model ErthboxLocation {
  id        String   @id @default(cuid())
  name      String
  address   String
  city      String
  picName   String
  picPhone  String
  notes     String?
  isActive  Boolean  @default(true)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]
}

model AiConversation {
  id         String      @id @default(cuid())
  userId     String
  title      String      @default("New Chat")
  isArchived Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  actions    AiAction[]
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   AiMessage[]
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String
  metadata       String?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AiAction {
  id             String         @id @default(cuid())
  conversationId String
  userId         String
  actionType     String
  entityType     String
  entityId       String
  description    String
  payload        String
  status         String         @default("PENDING")
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([userId, status])
}

model AiFlag {
  id             String    @id @default(cuid())
  userId         String
  conversationId String?
  messageContent String
  reason         String
  severity       String    @default("MEDIUM")
  isResolved     Boolean   @default(false)
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isResolved])
}

enum Role {
  ADMIN
  HERO
  SUPPORT
}
