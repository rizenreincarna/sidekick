<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sidekick" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_dark</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="colorOnPrimary">@color/brand_white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Draw content behind system bars so the webapp's safe-area-inset envs work -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowBackground">@color/brand_dark</item>
    </style>

    <style name="Theme.Sidekick.Splash" parent="Theme.Sidekick">
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>
</resources>