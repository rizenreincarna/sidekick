<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main theme — dark-first, transparent system bars -->
    <style name="Theme.RizenCC" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>

    <!-- Splash variant — solid dark background before Compose loads -->
    <style name="Theme.RizenCC.Splash" parent="Theme.RizenCC">
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>
</resources>
